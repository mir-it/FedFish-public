FB_HOST=
FB_PORT=80
FB_USERNAME=
FB_PASSWORD=

SYNAPSE_BASE_URL=
SYNAPSE_USERNAME=
SYNAPSE_PASSWORD=
SYNAPSE_CUSTID=
SYNAPSE_FROM_FACILITY=
SYNAPSE_TO_FACILITY=
SYNAPSE_CARRIER=9999
SYNAPSE_GENERATE_LABELS=N
SYNAPSE_SHIP_TYPE=S
SYNAPSE_SHIPMENT_TERMS=3RD
SYNAPSE_INVENTORY_STATUS=20
SYNAPSE_REQUIRE_LOT=Y
SYNAPSE_CANCEL_AFTER_DAYS=7

# Optional: path to the CSV used to convert SF -> EA.
# If omitted, the app will also look for a file named PRODUCT_COVERAGE_CSV
# or PRODUCT_COVERAGE_CSV.csv inside the project folder.
PRODUCT_COVERAGE_CSV=

EXCLUDE_ITEM_KEYWORDS=shipping,freight,fee

# Email (SMTP) for "Email PDF to NJ". For Gmail, SMTP_PASSWORD is a 16-char App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
NJ_WAREHOUSE_EMAIL=
NJ_WAREHOUSE_CC=

# FedFish Central: name this PC shows up as in the dashboard, e.g. the employee who uses it.
# Blank uses the Windows computer name. CENTRAL_URL=off turns uploads off.
CENTRAL_CLIENT_NAME=
CENTRAL_URL=off
